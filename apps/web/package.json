{
  "name": "@openvenue/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @openvenue/scene-schema --filter @openvenue/geometry --filter @openvenue/editor-core --filter @openvenue/scene-engine build",
