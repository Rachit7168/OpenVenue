    "autoprefixer": "^10.4.21",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "catalog:",
    "vite": "^7.1.12",
    "vitest": "catalog:",
    "vue-tsc": "^3.1.1"
  }
