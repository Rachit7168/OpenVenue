{
  "name": "@openvenue/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @openvenue/scene-schema --filter @openvenue/geometry --filter @openvenue/editor-core --filter @openvenue/scene-engine --filter @openvenue/renderer-2d --filter @openvenue/renderer-3d build && vite",
    "build": "vite build",
    "typecheck": "pnpm --filter @openvenue/scene-schema --filter @openvenue/geometry --filter @openvenue/editor-core --filter @openvenue/scene-engine --filter @openvenue/renderer-2d --filter @openvenue/renderer-3d build && vue-tsc --noEmit",
    "test": "pnpm --filter @openvenue/scene-schema --filter @openvenue/geometry --filter @openvenue/editor-core --filter @openvenue/scene-engine --filter @openvenue/renderer-2d --filter @openvenue/renderer-3d build && vitest run"
  },
  "dependencies": {
    "@openvenue/editor-core": "workspace:*",
    "@openvenue/geometry": "workspace:*",
    "@openvenue/renderer-2d": "workspace:*",
    "@openvenue/renderer-3d": "workspace:*",
    "@openvenue/scene-engine": "workspace:*",
    "@openvenue/scene-schema": "workspace:*",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.21",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "catalog:",
    "vite": "^7.1.12",
    "vitest": "catalog:",
    "vue-tsc": "^3.1.1"
  }
}
