{
  "name": "@openvenue/viewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Read-only visitor app. Separate from the editor so it can be embedded on an event site.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@openvenue/geometry": "workspace:*",
    "@openvenue/renderer-3d": "workspace:*",
    "@openvenue/scene-schema": "workspace:*",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "catalog:",
    "vite": "^7.1.12",
    "vitest": "catalog:"
  }
}
