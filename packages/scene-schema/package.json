{
  "name": "@openvenue/scene-schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "venue.json schema, TypeScript types, and runtime validation.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./src/schema/venue.schema.json"
  },
  "scripts": {
    "generate": "json2ts -i src/schema/venue.schema.json -o src/generated/venue.ts --bannerComment '/* Generated from src/schema/venue.schema.json. Do not edit by hand. */'",
    "build": "tsc -p tsconfig.json && node scripts/copy-schema.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
