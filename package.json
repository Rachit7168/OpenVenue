{
  "name": "openvenue",
  "private": true,
  "version": "0.0.0",
  "description": "Local-first venue designer for events.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @openvenue/web dev",
    "build": "pnpm -r --if-present build",
    "test": "pnpm --filter @openvenue/scene-schema build && pnpm -r --if-present test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @openvenue/scene-schema build && pnpm -r --if-present typecheck",
    "generate": "pnpm --filter @openvenue/scene-schema generate && prettier --write packages/scene-schema/src/generated/venue.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.5.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.0"
  }
}
